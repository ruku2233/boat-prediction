import requests
from bs4 import BeautifulSoup
import json
import re
from datetime import datetime

HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
}

def check_active_venues(date_str):
    url = f"https://www.boatrace.jp/owpc/pc/race/index?hd={date_str}"
    active_venues = []
    try:
        res = requests.get(url, headers=HEADERS, timeout=8)
        if res.status_code == 200:
            soup = BeautifulSoup(res.content, "html.parser")
            for link in soup.select("a[href*='jcd=']"):
                m = re.search(r"jcd=(\d{2})", link["href"])
                if m and m.group(1) not in active_venues:
                    active_venues.append(m.group(1))
    except Exception as e:
        print(f"会場確認エラー: {e}")
    return active_venues

def fetch_racelist(jcd, rno, date_str):
    url = f"https://www.boatrace.jp/owpc/pc/race/racelist?rno={rno}&jcd={jcd}&hd={date_str}"
    try:
        res = requests.get(url, headers=HEADERS, timeout=8)
        if res.status_code != 200: return None
        
        soup = BeautifulSoup(res.content, "html.parser")
        tbodies = soup.select("div.table1 table tbody")
        if not tbodies: return None
        
        entries = []
        boat_count = 0
        for tbody in tbodies:
            name_tag = tbody.select_one("div.is-fs18")
            if not name_tag: continue
            
            boat_count += 1
            if boat_count > 6: break
            
            racer_name = name_tag.get_text(strip=True).replace(" ", "").replace(" ", "")
            text_block = tbody.get_text()
            
            class_match = re.search(r"([AB][12])", text_block)
            racer_class = class_match.group(1) if class_match else "B1"
            
            rates = re.findall(r"\d+\.\d+", text_block)
            
            entries.append({
                "boat": boat_count,
                "name": racer_name,
                "class": racer_class,
                "national_win_rate": float(rates[0]) if len(rates) > 0 else 5.00,
                "motor_2rate": float(rates[2]) if len(rates) > 2 else 30.0
            })
            
        return {
            "race_no": int(rno),
            "deadline": "発売終了",
            "entries": entries
        }
    except Exception:
        return None

if __name__ == "__main__":
    now = datetime.now()
    date_str = now.strftime("%Y%m%d")
    
    print("本日の開催会場を確認中...")
    venues = check_active_venues(date_str)
    print(f"検出された開催地コード: {venues}")
    
    venue_names = {
        "01":"桐生", "02":"戸田", "03":"江戸川", "04":"平和島", "05":"多摩川", "06":"浜名湖",
        "07":"蒲郡", "08":"常滑", "09":"津", "10":"三国", "11":"びわこ", "12":"住之江",
        "13":"尼崎", "14":"鳴門", "15":"丸亀", "16":"児島", "17":"宮島", "18":"徳山",
        "19":"下関", "20":"若松", "21":"芦屋", "22":"福岡", "23":"唐津", "24":"大村"
    }
    
    result_venues = []
    for jcd in venues:
        v_name = venue_names.get(jcd, jcd)
        print(f"[{v_name}] 出走表データ取得中...")
        races = []
        for rno in range(1, 13):
            r_data = fetch_racelist(jcd, rno, date_str)
            if r_data and r_data["entries"]:
                races.append(r_data)
        
        if races:
            result_venues.append({"venue_code": jcd, "venue_name": v_name, "races": races})
            print(f"  └ {v_name}: {len(races)}レースの選手データを正常に取得")

    full_data = {
        "date": now.strftime("%Y-%m-%d"),
        "news": [{"id": 1, "title": "全場出走表・AI予想データを更新完了", "date": now.strftime("%Y-%m-%d")}],
        "venues": result_venues
    }

    with open("data.json", "w", encoding="utf-8") as f:
        json.dump(full_data, f, ensure_ascii=False, indent=2)
    print("\n✅ data.json への書き込みが完了しました！")
